--- a/Makefile
+++ b/Makefile
@@ -1,3 +1,14 @@
+# Kernel 6.x compatibility: $(src) is no longer reliably set for out-of-tree
+# module builds.  Provide a fallback so that EXTRA_CFLAGS include-path
+# expansions below resolve to the module source root regardless of kernel
+# version.
+ifeq ($(src),)
+  src := $(M)
+endif
+ifeq ($(src),)
+  src := $(shell pwd)
+endif
+
 ########### CONFIGURATION ##########
